DATA_DIR=backend/Dataset
DATABASE_PATH=var/nomad.sqlite3
# Empty uses meta.as_of_date from the dataset (2026-10-01 for the starter kit).
AS_OF_DATE=
# scripts/run.py generates an ignored local AUTH_SECRET if this is empty.
AUTH_SECRET=
HR_ACCESS_CODE=
EMPLOYEE_ACCESS_CODES={}
COOKIE_SECURE=false

# none, local, openai, nvidia or openai-compatible (see README)
AI_PROVIDER=none
AI_MODEL=
# For local: http://127.0.0.1:11434/v1/chat/completions
AI_BASE_URL=
AI_API_KEY=
OPENAI_MODEL=
OPENAI_API_KEY=
NVIDIA_MODEL=
NVIDIA_API_KEY=
# Enable only when external processing of derived facts is permitted.
AI_ALLOW_EXTERNAL_DERIVED=false
